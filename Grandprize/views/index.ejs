<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Njajal Sek</title>

  <link rel="stylesheet" href="./css/bootstrap.css">
  <link rel="stylesheet" href="./css/bootstrap-reboot.css">
  <link rel="stylesheet" href="./css/style.css">
</head>
<body>

  <div class="background-only position-absolute h-100 w-100 bg-stars"></div>

  <div class="backdrop-winner d-none">
    <div class="bg-fireworks"></div>
    <div class="nduwur-dewe">

      <div class="d-flex flex-column min-vh-100 min-vw-100 position-absolute logo-index">
        <div class="d-flex flex-grow-1 justify-content-center align-items-center" id="thewinner">
    
          
          
        </div>
      </div>

    </div>
  </div>

  <div class="arrows arrow-1">
    <img src="images/arrow-1.gif" class="img-fluid" alt="bg-arrow">
  </div>
  <div class="arrows arrow-3">
    <img src="images/arrow-3.gif" class="img-fluid" alt="bg-arrow">
  </div>
  <div class="arrows arrow-4">
    <img src="images/arrow-4.gif" class="img-fluid" alt="bg-arrow">
  </div>

  <div class="d-flex flex-column min-vh-100 min-vw-100 position-absolute logo-index">
    <div class="d-flex flex-grow-1 justify-content-center align-items-start">

      <div class="container container-logo mt-5">
        <div class="row justify-content-center">
          <div class="col-6">
            <img src="images/logo.png" class="img-fluid" alt="bg-slot">
          </div>
        </div>
      </div>
      
    </div>
  </div>

  <div class="d-flex flex-column min-vh-100 min-vw-100">
    <div class="d-flex flex-grow-1 justify-content-center align-items-end">

      <div class="container position-relative container-slot">
        <div class="row">
          <div class="col g-0">

            <div class="layer-1"  >
              
              <div class="d-flex flex-column w-100 h-100">
                <div class="d-flex flex-grow-1 justify-content-center align-items-center">
                  <div class='main-container'>
                    <div class='reel-container'>
                      <div class="reel">
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <div class="layer-2">
              <img src="images/bg-slot.png" class="img-fluid" alt="bg-slot">
            </div>
              
          </div>
        </div>
      </div> 
      
    </div>
  </div>

  <script src="js/jquery-3.7.1.js"></script>
  <script src="js/script.js"></script>
  <script>
    $(window).on( 'resize', function () {
      $('.main-container').height( $('.main-container').width() + ( $('.main-container').width() * 0.3 ));
      $('.photo-card-div').height( $('.main-container').height() - $('.bottom-card-div').height() - 25);
    }).resize();
    
  </script>
</body>
</html>