<%- include('../templates/header.ejs') %>

  <div class="container-sm mpm-container my-5">
    <div class="card">
      <div class="card-header">
        <div class="row">
          <div class="col">
            <a href="./" class="btn btn-danger">Back</a>
          </div>
          <div class="col text-center">
            <h5 class="my-2">Item List</h5>
          </div>
          <div class="col">
            <button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#modalPopUp">
              Add Item
            </button>
          </div>
        </div>
      </div>
      <div class="card-body">
        <table id="item-table" class="table table-striped table-hover d-none">
          <thead>
              <tr>
                  <th>Item Name</th>
                  <th>QTY</th>
                  <th>Action</th>
              </tr>
          </thead>
        </table>
        <div class="d-flex justify-content-center" id="spinner-loader">
          <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;"  role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../templates/modal.ejs', 
    {
      "modal_name": "Add New Item",
      "modal_body": String(
        `<form id="insertNewItem">
          <div class="mb-3">
            <label for="itemName" class="form-label">Item Name</label>
            <input type="text" class="form-control" id="itemName">
          </div>
          <div class="mb-3">
            <label for="itemQty" class="form-label">Item QTY</label>
            <input type="text" class="form-control" id="itemQty">
          </div>
        </form>`
      )
    }
  ) %>

  <script>
    const itemTable = new DataTable('#item-table',
      {
        "searching": false, 
        "paging": false, 
        "info": false,
        "ordering": false,
        "autoWidth": false,
          "columnDefs": [
            { "width": "75%", "targets": 0 },
            { "width": "5%", "targets": 1 },
            { "width": "20%", "targets": 2 }
          ],
        "columns": [
          { data: "name" },
          { data: "qty" },
          { data: "id", render: (data) => {
              return `
                <button class="btn btn-sm btn-warning">Edit</button>
                <button class="btn btn-sm btn-danger">Delete</button>
              `
            } 
          }
        ]
      }
    );

    $( document ).ready(() => {
      getAllItem();
    });

    const getAllItem = () => {
      showSpinner();
      $.get('http://localhost:3001/items')
        .done((data) => {
          itemTable.clear().rows.add(data).draw();
          hideSpinner();
        });
    }

    const saveData = () => {
      var itemName = $('#itemName').val();
      var itemQty = $('#itemQty').val();

      if(itemName == null || itemName == '' || itemQty == null || itemQty == '')
        toastr.error('Seluruh field harus diisi.')
      else if(!/^\d+$/.test(itemQty) || itemQty <= 0)
        toastr.error('QTY hanya dapat diisi dengan angka dan harus lebih dari 0.')
      else{
        $.post('http://localhost:3001/items',
          {
            "name": String(itemName),
            "qty": Number(itemQty)
          }
        ).done((data) => {
          getAllItem();
          toastr.success(`Item ${ itemName } dengan QTY ${ itemQty } berhasil ditambahkan.`)
          $("#insertNewItem")[0].reset();
          $('#modalPopUp').modal('hide');
        });
      }
    }

    const showSpinner = () => {
      $("#item-table").addClass("d-none");
      $("#spinner-loader").removeClass("d-none");
    }

    const hideSpinner = () => {
      $("#spinner-loader").addClass("d-none");
      $("#item-table").removeClass("d-none");
    }

  </script>

<%- include('../templates/footer.ejs') %>