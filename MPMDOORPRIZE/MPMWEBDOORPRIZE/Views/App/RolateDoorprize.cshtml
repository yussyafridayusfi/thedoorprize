    function sethadiah() {
      console.log(Hadiah);
      if (!Hadiah || Hadiah.length === 0) {
        $("#hadiahNama").text("No prize");
        $("#listPemenang").empty();
        return;
      }

      document.getElementById("hadiahNama").innerHTML = Hadiah[0].nama;
      $("#listPemenang").empty(); // clear existing

      let jumlah = parseInt(Hadiah[0].jumlah) || 0;
      const perRow = 3;
      let rowContainer = null;

      for (let i = 1; i <= jumlah; i++) {
        // start new row every perRow items
        if ((i - 1) % perRow === 0) {
          rowContainer = $("<div>").addClass("hadiah-row");
          $("#listPemenang").append(rowContainer);
        }

        // create column/card
        const col = $("<div>").addClass("hadiah-col");
        const card = $("<div>").addClass("card");
        const inner = $("<div>")
          .addClass("divBorder")
          .attr("id", "npk" + i)
          .text(".........");

        card.append(inner);
        col.append(card);
        rowContainer.append(col);
      }

      // if last row has less than perRow, optionally fill blank flex items for alignment
      const lastRowCols = $("#listPemenang .hadiah-row").last().children().length;
      if (lastRowCols > 0 && lastRowCols < perRow) {
        const blanks = perRow - lastRowCols;
        for (let b = 0; b < blanks; b++) {
          $("<div>").addClass("hadiah-col").append($("<div>").addClass("card").css("visibility", "hidden")).appendTo($("#listPemenang .hadiah-row").last());
        }
      }
    }




