<%- include('../templates/header.ejs') %>

  <div class="container-sm mpm-container my-5">
    <div class="card">
      <div class="card-header">
        <div class="row">
          <div class="col">
            <a href="./" class="btn btn-danger">Back</a>
          </div>
          <div class="col text-center">
            <h5 class="my-2">Item List</h5>
          </div>
          <div class="col"></div>
        </div>
      </div>
      <div class="card-body">
        <table id="item-table" class="table table-striped table-hover">
          <thead>
              <tr>
                  <th>#</th>
                  <th>Item Name</th>
                  <th>QTY</th>
              </tr>
          </thead>
        </table>
      </div>
    </div>
  </div>

  <script>

    $(document).ready(()=>{
      var columnDefs = [ 
        {
          title: "Id",
          type: "hidden",
          visible: false,
          data: "id"
        }, 
        {
          title: "Item Name",
          type: "text",
          required: true,
          unique: true,
          name: "name",
          data: "name"
        }, 
        {
          title: "QTY",
          required: true,
          type: "number",
          min: 1,
          name: "qty",
          data: "qty"
        }
      ];
  
      const itemTable = new DataTable('#item-table',
        {
          "ajax"        : {
            "url"       : '<%- process.env.API_URL %>/items',
            "dataSrc"   : ""
          },
          "paging"      : false, 
          "info"        : false,
          "ordering"    : false,
          "autoWidth"   : false,
          "dom"         : 'Bfrtip',
          "select"      : 'single',
          "altEditor"   : true,
          "buttons"     : [
              {
                  "text": "Add",
                  "name": "add"  
              },
              {
                  "extend": "selected",
                  "text": "Edit",
                  "name": "edit"  
              },
              {
                  "extend": "selected",
                  "text": "Delete",
                  "name": "delete"
              }
          ],
            "columnDefs": [
              { "width" : "90%", "targets": 1 },
              { "width" : "10%", "targets": 2 }
            ],
          "columns"     : columnDefs,
          onAddRow: function(datatable, rowdata, success, error) {
              $.ajax({
                  url: '<%- process.env.API_URL %>/items',
                  type: 'POST',
                  data: rowdata,
                  success: success,
                  error: error
              });
          },
          onDeleteRow: function(datatable, rowdata, success, error) {
              $.ajax({
                  url: '<%- process.env.API_URL %>/items/' + rowdata[0].id,
                  type: 'DELETE',
                  data: rowdata,
                  success: success,
                  error: error
              });
          },
          onEditRow: function(datatable, rowdata, success, error) {
              $.ajax({
                  url: '<%- process.env.API_URL %>/items/' + rowdata.id,
                  type: 'PUT',
                  data: rowdata,
                  success: success,
                  error: error
              });
          }
        }
      );
    });


  </script>

<%- include('../templates/footer.ejs') %>