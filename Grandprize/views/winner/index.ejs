<%- include('../templates/header.ejs') %>

  <div class="z-2 w-100 h-100 top-0 left-0 position-fixed opacity-50 bg-fireworks"></div>
  <div class="z-3 w-100 h-100 top-0 left-0 position-fixed">

    <div class="d-flex flex-column min-vh-100 justify-content-center align-items-center">
      
      <div class="container"></div>

    </div>

  </div>

  <script>
    var winners = []

    $( document ).ready( () => {
      loopWinners();
    });

    async function loopWinners() {
      var html = "";
      var countRow = 1

      await getAllItems();

      console.log(winners);

      winners.forEach( (winner, i) => {

        if( i % 6 == 0)
          html += `</div>`;
        
        if( i + 1 == 1 || i % 6 == 0) {
          html += `<div class="row d-none" id="row-${ countRow }">`;
          countRow++;
        }

        html += `
        <div class="col-4 py-5">
          <div class="row">
            <div class="col-12 text-center pb-3">
              <div class="badge bg-white text-dark text-wrap rounded-pill">
                <h4 class="my-1 mx-2">${ winner.participant.company } - ${ winner.participant.npk }</h4>
              </div>
            </div>
            <div class="col-12 d-flex justify-content-center" style="margin-top:-20px">
              <img src="<%- process.env.WEB_URL %>/images/winner.png" class="rounded-circle bg-white" alt="Cinque Terre" width="200" height="200">
            </div>
          </div>
          <div class="col-12 text-center pb-3" style="margin-top:-15px">
            <div class="badge bg-white text-dark text-wrap rounded-pill">
              <h4 class="my-1 mx-2">${ winner.participant.name }</h4>
            </div>
          </div>
          <div class="col-12 text-center">
            <div class="badge bg-orange-mpm text-wrap rounded-pill">
              <h4 class="my-1 mx-2">${ winner.item.name }</h4>
            </div>
          </div>
        </div>
        `;

      });

      $('.container').append( html );

      endlessLoop();

    }

    const timer = ms => new Promise(res => setTimeout(res, ms))

    async function endlessLoop () { 
      var i = 1;
      while(true){
        $(`#row-${ i }`).removeClass('d-none');
        await timer(3000);

        $(`#row-${ i }`).addClass('d-none');

        $(`#row-${ i  + 1}`).removeClass('d-none');
        console.log(i);

        if( i == Math.ceil( winners.length/6 ) )
          i = 0;

        i++;
      }
    }

    async function getAllItems() {
      await $.get('<%- process.env.API_URL %>/winners?_expand=item&_expand=participant').done( (data) => {
        this.winners = data;
      });
    }
  </script>

<%- include('../templates/footer.ejs') %>