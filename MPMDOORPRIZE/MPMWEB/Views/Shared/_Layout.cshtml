  <style>
      html, body {
        background: url('../../Content/TEMPLATE-IFLIP.PNG') no-repeat center center fixed;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
      }

      .divBorder {
        background-color: #B8860B; /* Goldenrod for a soft  effect */
        opacity: 1;
        filter: alpha(opacity=100);
        border-radius: 25px;
        color: #FFF5E1; /* Soft cream for readable text */
      }

      .divall {
        background-color: #8B0000; /* Deep red matching the banner background */
        box-shadow: 10px 10px 10px 5px rgba(0, 0, 0, 0.4); /* Slightly stronger shadow */
        color: #FFF5E1; /* Consistent soft cream text color */
      }



